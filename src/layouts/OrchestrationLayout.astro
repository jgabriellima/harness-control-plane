---
import AppLayout from './AppLayout.astro';

interface Props {
  title: string;
  description?: string;
  seedArtifactE2e?: boolean;
}

const { title, description, seedArtifactE2e = false } = Astro.props;
---

<AppLayout title={title} description={description} seedArtifactE2e={seedArtifactE2e} />
