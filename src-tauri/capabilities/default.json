{
  "identifier": "default",
  "description": "Default desktop shell capabilities",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "allow-secrets",
    "allow-sidecar",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/business-server",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/business-server",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
