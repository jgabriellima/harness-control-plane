{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ACME Workflow",
  "version": "0.1.0",
  "identifier": "com.acme.workflow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/before-tauri-build.mjs",
    "devUrl": "http://127.0.0.1:4321",
    "frontendDist": "../desktop-shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ACME Workflow",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "devtools": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: media:; object-src 'self' blob: data:; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https:; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; font-src 'self' data: https:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "externalBin": [
      "binaries/business-server"
    ],
    "resources": [
      "../dist/server",
      "../dist/client",
      "../desktop-sidecar/index.cjs",
      "../node_modules",
      "resources/shell",
      "resources/harness-baseline"
    ]
  }
}
